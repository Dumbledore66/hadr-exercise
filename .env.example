# Copy to .env and fill in. Model calls speak the OpenAI chat format against
# OPENAI_BASE_URL, billed to the OpenCode Go subscription.
OPENAI_KEY=sk-ZZZZZZZZZZZZZZZZZZZZZZZZZZ

# Do NOT point OPENAI_BASE_URL at the plain Zen base https://opencode.ai/zen/v1
# - it bills separate pay-as-you-go credits and fails with CreditsError once
# that balance is empty.
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
INTAKE_MODEL=mimo-v2.5
DISPATCH_MODEL=minimax-m3

# Optional: an INTAKE_ or DISPATCH_ prefix overrides the variable above for that
# role only. Uncomment to run intake against a local Ollama while dispatch stays
# on OpenCode.
# INTAKE_OPENAI_BASE_URL=http://localhost:11434/v1
# INTAKE_OPENAI_KEY=ollama
